// Bindings are repeated in every environment: an environment that omits one does not inherit it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deaftly-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development"
  },
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        "FEEDBACK_REPO": "oneloneraven/deaftly-feedback"
      },
      "ratelimits": [{ "name": "FEEDBACK_LIMITER", "namespace_id": "2101", "simple": { "limit": 5, "period": 60 } }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "routes": [
        {
          "pattern": "deaftly.com/*",
          "zone_name": "deaftly.com"
        }
      ]
    },
    "preview": {
      "vars": {
        "APP_ENV": "preview",
        "FEEDBACK_REPO": "oneloneraven/deaftly-feedback"
      },
      "ratelimits": [{ "name": "FEEDBACK_LIMITER", "namespace_id": "2102", "simple": { "limit": 5, "period": 60 } }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "workers_dev": true,
      "preview_urls": true,
      "previews": {
        "vars": {
          "APP_ENV": "preview"
        }
      }
    },
    "e2e": {
      "vars": {
        "APP_ENV": "e2e",
        "FEEDBACK_REPO": "oneloneraven/deaftly-feedback"
      },
      "ratelimits": [{ "name": "FEEDBACK_LIMITER", "namespace_id": "2103", "simple": { "limit": 5, "period": 60 } }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    }
  }
}

<details class="help-menu" id="help-browse" open>
<summary>Browse help topics</summary>
<nav aria-label="Help topics">
<ul>
{% for topic in help %}
<li><a href="{{ topic.url }}"{% if topic.url == page.url %} aria-current="page"{% endif %}>{{ topic.title }}</a></li>
{% endfor %}
</ul>
</nav>
</details>
